# Upstash Redis — added automatically when you connect the database in Vercel (Storage tab).
# Either naming style works; keep the names Vercel created.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: require a family access code to open the site (leave empty for "anyone with the link").
ACCESS_CODE=

# Optional: max changes per minute from one IP address (default 90).
# WRITE_LIMIT_PER_MIN=90

# Optional: key prefix. Production uses none (original data). Preview deployments
# automatically use "preview:" so tests never touch production data.
# KEY_PREFIX=
